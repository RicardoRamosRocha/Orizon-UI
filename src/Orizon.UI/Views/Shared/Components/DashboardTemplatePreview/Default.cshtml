@model Orizon.UI.Models.Templates.DashboardTemplatePreviewModel
@{
    var template = Model.Template;
    var manifest = Model.Manifest;
    var searchValue = string.Join(
        " ",
        new[] { manifest.Name, manifest.DisplayName, manifest.Category }
            .Concat(manifest.Tags)
            .Where(value => !string.IsNullOrWhiteSpace(value)));
}

<article class="orz-template-preview"
         data-template-card
         data-template-search="@searchValue.ToLowerInvariant()"
         data-template-category="@manifest.Category?.ToLowerInvariant()">
    <orizon-card variant="premium" padding="lg">
        <div class="orz-template-preview__placeholder"
             style="background-color:@manifest.PreviewColor"
             aria-label="Preview de @manifest.DisplayName">
            <orizon-icon name="dashboard" size="32" />
            <span>@(manifest.PreviewImage ?? "Preview")</span>
        </div>

        <header class="orz-template-preview__heading">
            <div>
                <span class="orz-template-preview__category">@manifest.Category</span>
                <h2>@manifest.DisplayName</h2>
            </div>
            @if (!string.IsNullOrWhiteSpace(manifest.Version))
            {
                <orizon-badge variant="primary" size="sm">@($"v{manifest.Version}")</orizon-badge>
            }
        </header>

        @if (!string.IsNullOrWhiteSpace(manifest.Description))
        {
            <p class="orz-template-preview__description">@manifest.Description</p>
        }

        <dl class="orz-template-preview__details">
            <div>
                <dt><orizon-icon name="dashboard" size="16" /> Layout</dt>
                <dd>@(manifest.LayoutName ?? "—")</dd>
            </div>
            <div>
                <dt><orizon-icon name="packages" size="16" /> Widgets</dt>
                <dd>@(manifest.Widgets.Count > 0 ? string.Join(", ", manifest.Widgets) : "—")</dd>
            </div>
            @if (!string.IsNullOrWhiteSpace(manifest.Author))
            {
                <div>
                    <dt><orizon-icon name="user" size="16" /> Autor</dt>
                    <dd>@manifest.Author</dd>
                </div>
            }
        </dl>

        @if (manifest.Tags.Count > 0)
        {
            <div class="orz-template-preview__tags" aria-label="Tags">
                @foreach (var tag in manifest.Tags)
                {
                    <orizon-badge variant="neutral" size="sm" pill>@tag</orizon-badge>
                }
            </div>
        }

        <div class="orz-template-preview__actions">
            <orizon-button href="/templates/dashboard/@manifest.Name"
                           text="Visualizar"
                           icon="eye"
                           size="sm" />
            <orizon-button href="#template-code-@manifest.Name"
                           text="Ver Código"
                           icon="code"
                           variant="outline"
                           size="sm" />
        </div>

        <section class="orz-template-preview__technical" aria-label="Informações técnicas">
            <h3>Informações Técnicas</h3>
            <p><strong>Registry key:</strong> <code>@manifest.Name</code></p>
            <p><strong>Layout:</strong> <code>@manifest.LayoutName</code></p>
        </section>

        <section class="orz-template-preview__code" id="template-code-@manifest.Name">
            <h3>Exemplo de Código</h3>
            <pre><code>@Model.UsageCode</code></pre>
        </section>
    </orizon-card>
</article>
